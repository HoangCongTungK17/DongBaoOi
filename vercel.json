{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "cd Frontend && npm install && npm run build",
  "outputDirectory": "Frontend/dist",
  "installCommand": "cd Frontend && npm install",
  "devCommand": "cd Frontend && npm run dev",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false
}
